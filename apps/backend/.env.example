# ─────────────────────────────────────────────────────────────────────────────
# Backend environment (apps/backend). Copy to `.env` (or rely on the root
# `.env` shared by the whole monorepo — app.module.ts reads several paths).
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Supabase/PostgreSQL) ---
# Connection string for the primary PostgreSQL database. Supabase pooler
# strings already include sslmode=require and are detected automatically.
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# --- Redis (BullMQ queue infrastructure) ---
# Used for the vendor sync job queues. Required by the fulfillment pipeline.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Phase 1 — Auth + RBAC ---
# JWT signing secret for access tokens. MUST be a strong random string in
# production — the app refuses to boot with the dev fallback when
# NODE_ENV=production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Access token lifetime (accepts s/m/h/d suffixes, e.g. 15m, 2h, 1d).
# Default: 15m
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days. Stored server-side as a SHA-256 hash.
# Default: 14
REFRESH_TOKEN_TTL_DAYS=14

# --- App ---
# NODE_ENV=production disables TypeORM synchronize (schema via migrations)
# and enforces JWT_SECRET.
NODE_ENV=development
PORT=3000