{
    "name": "@marketplace/backend",
    "version": "1.0.0",
    "private": true,
    "description": "NestJS backend Ã¢â‚¬â€ marketplace order fulfillment API",
    "scripts": {
        "build": "nest build",
        "start": "node dist/main.js",
        "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
        "test": "jest",
        "test:e2e": "jest --config ./jest-e2e.config.js",
        "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
        "load-test": "ts-node -r tsconfig-paths/register src/database/load-test.ts",
        "migration:run": "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts up",
        "migration:revert": "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts revert",
        "migration:status": "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts status",
        "type-check": "npx tsc --noEmit",
        "lint": "echo No ESLint for backend.",
        "clean": "rimraf dist",
        "dev": "nest start --watch"
    },
    "dependencies": {
        "@nestjs/bullmq": "^10.2.3",
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.3.0",
        "@nestjs/core": "^10.4.15",
        "@nestjs/platform-express": "^10.4.15",
        "@nestjs/schedule": "^4.1.2",
        "@nestjs/typeorm": "^10.0.2",
        "bullmq": "^5.81.4",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "ioredis": "^5.11.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.31",
        "uuid": "^11.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/testing": "^10.4.15",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.0",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "rimraf": "^5.0.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3"
    },
    "main": "dist/main.js"
}