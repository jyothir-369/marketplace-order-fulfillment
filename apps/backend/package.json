{
    "name":  "@marketplace/backend",
    "version":  "1.0.0",
    "private":  true,
    "scripts":  {
                    "build":  "nest build",
                    "start":  "node dist/main.js",
                    "start:dev":  "nest start --watch",
                    "lint":  "eslint \"{src,test}/**/*.ts\" --fix",
                    "typecheck":  "tsc --noEmit",
                    "test":  "cross-env jest",
                    "seed":  "ts-node -r tsconfig-paths/register src/database/seed.ts",
                    "load-test":  "ts-node -r tsconfig-paths/register src/database/load-test.ts",
                    "migration:run":  "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts up",
                    "migration:revert":  "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts revert",
                    "migration:status":  "ts-node -r tsconfig-paths/register src/database/migrations/migration-runner.ts status",
                    "migration:production:status":  "ts-node -r tsconfig-paths/register src/database/migrations/production-migration-runner.ts status",
                    "migration:production:up":  "ts-node -r tsconfig-paths/register src/database/migrations/production-migration-runner.ts up",
                    "migration:verify":  "ts-node -r tsconfig-paths/register src/database/migrations/migration-verify.ts"
                },
    "dependencies":  {
                         "@nestjs/bullmq":  "^10.2.3",
                         "@nestjs/common":  "10.4.15",
                         "@nestjs/config":  "3.3.0",
                         "@nestjs/core":  "10.4.15",
                         "@nestjs/jwt":  "^10.2.0",
                         "@nestjs/platform-express":  "10.4.15",
                         "@nestjs/schedule":  "4.1.2",
                         "@nestjs/throttler":  "^6.6.0",
                         "@nestjs/typeorm":  "10.0.2",
                         "bcryptjs":  "^3.0.3",
                         "bullmq":  "5.45.2",
                         "class-transformer":  "0.5.1",
                         "class-validator":  "0.14.1",
                         "google-auth-library":  "^11.3.1",
                         "ioredis":  "5.6.1",
                         "nestjs-pino":  "^4.0.0",
                         "pg":  "8.16.0",
                         "pino":  "^10.3.1",
                         "pino-http":  "^11.0.0",
                         "pino-pretty":  "^13.1.3",
                         "razorpay":  "^2.9.8",
                         "reflect-metadata":  "0.2.2",
                         "resend":  "^6.34.1",
                         "rxjs":  "7.8.2",
                         "sqlite3":  "^5.1.7",
                         "typeorm":  "^0.3.31",
                         "uuid":  "11.1.0"
                     },
    "devDependencies":  {
                            "@nestjs/cli":  "10.4.9",
                            "@nestjs/testing":  "10.4.15",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/express":  "5.0.3",
                            "@types/jest":  "29.5.14",
                            "@types/node":  "22.15.21",
                            "@types/supertest":  "^7.2.1",
                            "@typescript-eslint/eslint-plugin":  "^8.72.0",
                            "@typescript-eslint/parser":  "^8.72.0",
                            "cross-env":  "^10.1.0",
                            "eslint":  "^8.57.1",
                            "jest":  "29.7.0",
                            "supertest":  "^7.3.1",
                            "ts-jest":  "29.4.12",
                            "ts-node":  "10.9.2",
                            "tsconfig-paths":  "4.2.0",
                            "typescript":  "5.8.3"
                        }
}
