import { parseMigrationTestDbUrl } from '../database/migrations/datasource';
// Regression: datasource must throw on missing/invalid URL; never fall back
describe('datasource fail-closed', () => {
  const original = process.env.MIGRATION_TEST_DATABASE_URL;
  afterEach(() => { process.env.MIGRATION_TEST_DATABASE_URL = original; });
  it('throws when MIGRATION_TEST_DATABASE_URL missing', () => {
    delete process.env.MIGRATION_TEST_DATABASE_URL;
    expect(() => parseMigrationTestDbUrl()).toThrow();
  });
  it('throws on invalid protocol', () => {
    process.env.MIGRATION_TEST_DATABASE_URL = 'http://localhost:55439/marketplace_migration_test';
    expect(() => parseMigrationTestDbUrl()).toThrow();
  });
  it('accepts valid postgresql URL', () => {
    process.env.MIGRATION_TEST_DATABASE_URL = 'postgresql://user:pass@localhost:55439/marketplace_migration_test';
    const r = parseMigrationTestDbUrl();
    expect(r.database).toBe('marketplace_migration_test');
  });
});
