import { describe, it, expect, beforeAll, afterAll } from '@jest/globals';
import { DataSource } from 'typeorm';
import { loadCanonicalMigrationClasses } from '../canonical-migrations';
const rawUrl = process.env.MIGRATION_3A_TEST_DATABASE_URL;
describe('3A Existing-schema upgrade (real fixture + real migrations)', () => {
  let ds: DataSource;
  beforeAll(async () => {
      if (!rawUrl) throw new Error('BLOCKED: MIGRATION_3A_TEST_DATABASE_URL is required');
  const u = new URL(rawUrl);
    if (!['127.0.0.1','localhost'].includes(u.hostname) || !/^\d{1,5}$/.test(u.port) || Number(u.port) -lt 1 || Number(u.port) -gt 65535 || !/^\/cat3verify_\d{14}$/.test(u.pathname)) throw new Error('BLOCKED: target must be a localhost cat3verify disposable database');
    ds = new DataSource({ type: 'postgres', url: rawUrl, entities: [], migrations: loadCanonicalMigrationClasses(), migrationsTableName: 'migrations', synchronize: false, logging: false });
    await ds.initialize();
    await ds.query(`CREATE TABLE IF NOT EXISTS vendors_pre (id UUID PRIMARY KEY DEFAULT gen_random_uuid(), name VARCHAR(255))`);
    await ds.query(`INSERT INTO vendors_pre (id, name) VALUES ('00000000-0000-4000-8000-000000000001', 'PreUpgradeVendor')`);
  }, 30000);
  afterAll(async () => { if (ds?.isInitialized) await ds.destroy(); });
  it('starting schema predates migration chain (fixture data present)', async () => {
    const pre = await ds.query(`SELECT * FROM vendors_pre WHERE name = 'PreUpgradeVendor'`);
    expect(pre.length).toBe(1);
  });
  it('upgrade applies remaining canonical migrations', async () => {
    await ds.runMigrations({ transaction: 'each' });
    const hist = await ds.query(`SELECT name FROM migrations ORDER BY timestamp ASC`);
    expect(hist.length).toBeGreaterThan(0);
  });
  it('fixture data preserved after upgrade', async () => {
    const pre = await ds.query(`SELECT * FROM vendors_pre`);
    expect(pre.length).toBeGreaterThanOrEqual(1);
  });
  it('idempotent second run applies zero new', async () => {
    const second = await ds.runMigrations({ transaction: 'each' });
    expect(second).toHaveLength(0);
  });
});
