# ---------------------------------------------------------------------------
# apps/frontend/.env.local — local dev override (this file is NOT committed).
#
# Copy this file to `.env.local` for local development. Do not commit `.env.local`.
# ---------------------------------------------------------------------------

# Backend API base URL for the browser to call.
#
# LOCAL DEV: point it at your locally running NestJS backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# PRODUCTION (Vercel) — do NOT hardcode a URL in this file.
#
# Set `NEXT_PUBLIC_API_BASE_URL` as an Environment Variable in the Vercel
# project settings:
#   NEXT_PUBLIC_API_BASE_URL=https://<railway-api-hostname>.up.railway.app/api
#
# Build-time `NEXT_PUBLIC_*` vars are inlined into the client bundle, so the
# value must point at the deployed backend AFTER it is live (Railway) and must
# be updated whenever the backend URL changes.
#
# Phase 0 hardening relies on:
#   - lib/api.ts resolving process.env.NEXT_PUBLIC_API_BASE_URL
#   - NEXT_PUBLIC_API_BASE_URL ?? NEXT_PUBLIC_API_URL ?? 'http://localhost:3001/api'
# ---------------------------------------------------------------------------