# ============================================
# Environment Configuration
# ============================================

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Database
# Windows dev: PG13 runs on 5433 (PG14 on 5434). WSL2 forwards 5432
# but its credentials are not accessible from this sandbox.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=marketplace

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# pgAdmin (Development only)
PGADMIN_EMAIL=admin@marketplace.local
PGADMIN_PASSWORD=admin

# Ports
API_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6379
PGADMIN_PORT=5050